    {
      "id": "RFRoTZ6Pmc0IB4AsMp3Qp",
      "type": "text",
      "x": -11344.613842849349,
      "y": -48918.75358985248,
      "width": 742.9166870117188,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7c",
      "roundness": null,
      "seed": 1438567880,
      "version": 345,
      "versionNonce": 1517512648,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780012674842,
      "link": null,
      "locked": false,
      "text": "RunJobs allocates a counter, jobs decrement their counter when they finish.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RunJobs allocates a counter, jobs decrement their counter when they finish.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8vYtlGuABtxHeB7nH5mEf",
      "type": "text",
      "x": -12073.287857304209,
      "y": -48562.1443108413,
      "width": 800.6666870117188,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7f",
      "roundness": null,
      "seed": 26601928,
      "version": 567,
      "versionNonce": 2053395641,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "UoCYYdLJwig44NpEit282",
          "type": "arrow"
        }
      ],
      "updated": 1780048379044,
      "link": null,
      "locked": false,
      "text": "Counters keep a linked list of fibres that are waiting for them to reach 0,\nWhen they do the fibre is pushed into the local queue of the worker that has \ndecremented the counter where it will be dequeued and finished by that thread or\nstolen by another",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Counters keep a linked list of fibres that are waiting for them to reach 0,\nWhen they do the fibre is pushed into the local queue of the worker that has \ndecremented the counter where it will be dequeued and finished by that thread or\nstolen by another",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
