    {
      "id": "gWsWIgEuVe81w1WxsD9bx",
      "type": "text",
      "x": -10771.771736507979,
      "y": -47662.64195229699,
      "width": 609.4166870117188,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7l",
      "roundness": null,
      "seed": 1704902072,
      "version": 727,
      "versionNonce": 997685472,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780047273603,
      "link": null,
      "locked": false,
      "text": "A fibre that tries to get work in a loop.\nOrder that scheduler job try to get work:\n- local queue\n    - an existing fibre\n- high priority queue\n    - will need to allocate a new fibre\n- medium priority queue\n    - will need to allocate a new fibre\n- low priority queue\n    - will need to allocate a new fibre\n- try to steal work from other threads\n    - an existing fibre, but we can't deallocate it when finished\n    because it belongs to another workers fibre pool",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A fibre that tries to get work in a loop.\nOrder that scheduler job try to get work:\n- local queue\n    - an existing fibre\n- high priority queue\n    - will need to allocate a new fibre\n- medium priority queue\n    - will need to allocate a new fibre\n- low priority queue\n    - will need to allocate a new fibre\n- try to steal work from other threads\n    - an existing fibre, but we can't deallocate it when finished\n    because it belongs to another workers fibre pool",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "bXIifbemmYLh2MuRXhqlC",
