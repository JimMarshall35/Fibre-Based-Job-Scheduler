      "updated": 1780012897002,
      "link": null,
      "locked": false,
      "text": "Queues on to which new jobs are pushed:\nsingle consumer, multiple producer lock free\nqueues\n\nWhen jobs are pushed here, they're not yet\nstarted and are don't yet have a fibre \nallocated for them",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Queues on to which new jobs are pushed:\nsingle consumer, multiple producer lock free\nqueues\n\nWhen jobs are pushed here, they're not yet\nstarted and are don't yet have a fibre \nallocated for them",
      "autoResize": true,
      "lineHeight": 1.25
    },
