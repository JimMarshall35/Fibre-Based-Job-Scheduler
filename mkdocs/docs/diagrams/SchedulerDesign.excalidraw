    {
      "id": "xE47C1sGHFpd44Vw_3oq7",
      "type": "text",
      "x": -12439.887706347004,
      "y": -49294.56625471776,
      "width": 784.3666381835938,
      "height": 1175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7Y",
      "roundness": null,
      "seed": 118366648,
      "version": 443,
      "versionNonce": 1023799584,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "dOaiwA5Gx2ilofZHuabSO",
          "type": "arrow"
        },
        {
          "id": "UoCYYdLJwig44NpEit282",
          "type": "arrow"
        }
      ],
      "updated": 1780047731689,
      "link": null,
      "locked": false,
      "text": "\n\ntypedef void (*ExecuteFn)(void*, Jobs::WorkerThread*);\n\nvoid WaitForCounter(WorkerThread* pThisThread, Counter* pCtr);\n\nCounter* RunJobs(JobDecl* pJobs, int numJobs);\n\n\n// normal threads can't be context switched as fibres, so can't \"wait\"\n// in the same way as worker threads\nvoid WaitForCounterOSThread(Counter* pCtr, int sleepMS=0);\n\nstruct Counter\n{\n    std::atomic<int> value;\n\n    // Wait list of Fibers waiting on this counter\n    Fiber* waitListHead = nullptr;\n    size_t id = 0;\n};\n\nstruct Job\n{\n    // a function pointer that takes a void* for user data and a WorkerThread*\n    ExecuteFn execute; \n    void* userData;\n    \n    // private\n    Counter* counter;\n    Job* next;\n};\n\nstruct JobDecl\n{\n    JobPriority priority;\n    Job job;\n};\n\nenum class JobPriority\n{\n    Undefined,\n    High,\n    Medium,\n    Low,\n    NumberOfPriorities\n};",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\ntypedef void (*ExecuteFn)(void*, Jobs::WorkerThread*);\n\nvoid WaitForCounter(WorkerThread* pThisThread, Counter* pCtr);\n\nCounter* RunJobs(JobDecl* pJobs, int numJobs);\n\n\n// normal threads can't be context switched as fibres, so can't \"wait\"\n// in the same way as worker threads\nvoid WaitForCounterOSThread(Counter* pCtr, int sleepMS=0);\n\nstruct Counter\n{\n    std::atomic<int> value;\n\n    // Wait list of Fibers waiting on this counter\n    Fiber* waitListHead = nullptr;\n    size_t id = 0;\n};\n\nstruct Job\n{\n    // a function pointer that takes a void* for user data and a WorkerThread*\n    ExecuteFn execute; \n    void* userData;\n    \n    // private\n    Counter* counter;\n    Job* next;\n};\n\nstruct JobDecl\n{\n    JobPriority priority;\n    Job job;\n};\n\nenum class JobPriority\n{\n    Undefined,\n    High,\n    Medium,\n    Low,\n    NumberOfPriorities\n};",
      "autoResize": true,
      "lineHeight": 1.25
    },
