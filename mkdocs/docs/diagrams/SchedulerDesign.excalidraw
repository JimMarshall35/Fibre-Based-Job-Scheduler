    {
      "id": "RoEMQNK0JydTR6nTsiKoI",
      "type": "text",
      "x": -10080.726214625582,
      "y": -47562.69902901024,
      "width": 1204.2166748046875,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
