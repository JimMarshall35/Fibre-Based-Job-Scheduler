    },
    {
      "id": "mDIcFWAsQuV9ifztb9fse",
      "type": "arrow",
      "x": -10806.592988498645,
      "y": -47609.16589378263,
      "width": 654.5985490779767,
      "height": 190.22953724770923,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7s",
