        }
      ],
      "updated": 1780012926790,
      "link": null,
      "locked": false,
      "text": "Queue onto which jobs are \npushed when they return from the wait\nlist of a counter, to be resumed.\n\nThis is a double ended queue that one end the worker pushes to and the other,\nother worker threads can steal from:\n\nhttps://www.dre.vanderbilt.edu/~schmidt/PDF/work-stealing-dequeue.pdf",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Queue onto which jobs are \npushed when they return from the wait\nlist of a counter, to be resumed.\n\nThis is a double ended queue that one end the worker pushes to and the other,\nother worker threads can steal from:\n\nhttps://www.dre.vanderbilt.edu/~schmidt/PDF/work-stealing-dequeue.pdf",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Q0qBalSdgNEOtZsw8dwVE",
